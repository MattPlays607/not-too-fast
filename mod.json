
{
    "geode": "6.0.0-alpha.1",
    "gd": {
        "win": "2.2091",
        "android": "2.2091",
        "mac": "2.2091",
        "ios": "2.2091"
    },
    "id": "mattplays607.not-too-fast",
    "name": "Not Too Fast!",
    "version": "v1.0.0",
    "developer": "MattPlays607",
    "description": "Speeds up the game every click or death",
    "settings": {
        "trigger": {
            "name": "Speed Increase Trigger",
            "description": "Choose when the game speed increases.",
            "type": "string",
            "default": "death",
            "one-of": ["death", "click"]
        },
        "speed-increase": {
            "name": "Speed Increase (%)",
            "description": "How much the speed increases each time.",
            "type": "float",
            "default": 5.0,
            "min": 1.0,
            "max": 50.0,
            "control": {
                "slider": true,
                "slider-step": 1
            }
        },
        "starting-speed": {
            "name": "Starting Speed",
            "type": "float",
            "default": 1.0,
            "min": 1.0,
            "max": 3.0,
            "control": {
                "slider": true,
                "slider-step": 0.1
            }
        },
        "max-speed": {
            "name": "Maximum Speed",
            "description": "The maximum game speed multiplier.",
            "type": "int",
            "default": 10,
            "min": 2,
            "max": 10,
            "control": {
                "slider": true,
                "slider-step": 1
            }
        },
        "keep-speed-between-levels": {
            "name": "Keep Speed Between Levels",
            "description": "Remember your speed when exiting a level and restore it when entering another.",
            "type": "bool",
            "default": false
        },
        "show-speed": {
            "name": "Show Speed Multiplier",
            "type": "bool",
            "default": true
        },
        "reset-key": {
            "name": "Reset Speed Key",
            "description": "Press this key to reset the speed.",
            "type": "keybind",
            "default": "R",
            "category": "gameplay"
        }
    }
}
